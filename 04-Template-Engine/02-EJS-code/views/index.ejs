<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <style>
      * {
        color: white;
        background-color: black;
      }
    </style>
  </head>
  <body>
    <h1><%= title %></h1>
    <p><%= message %></p>
    <% if (userName) { %>
    <p><%= userName %></p>
    <% } %>
    <ul>
      <% language.forEach(lang => { %>
      <li><%= lang _%></li>
      <%}) %>
    </ul>
  </body>
</html>
