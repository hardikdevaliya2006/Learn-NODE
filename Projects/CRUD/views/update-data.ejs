<%- include('partials/header.ejs') %>

<!-- content -->
<main class="py-5" style="background-color: #121212; color: #e0e0e0">
  <div class="container">
    <div class="row justify-content-md-center">
      <div class="col-md-8">
        <div class="card bg-dark text-light">
          <div class="card-header card-title bg-secondary text-light">
            <strong>Update Data</strong>
            <!-- or Update Data -->
          </div>
          <div class="card-body">
            <form action="/update-data/<%= requestedData._id %>" method="post">
              <div class="row">
                <div class="col-md-12">
                  <div class="form-group row">
                    <label for="firstName" class="col-md-3 col-form-label"
                      >First Name</label
                    >
                    <div class="col-md-9">
                      <input
                        type="text"
                        name="firstName"
                        value="<%= requestedData.firstName %>"
                        id="firstName"
                        class="form-control bg-dark text-light border-secondary"
                      />
                    </div>
                  </div>

                  <div class="form-group row">
                    <label for="lastName" class="col-md-3 col-form-label"
                      >Last Name</label
                    >
                    <div class="col-md-9">
                      <input
                        type="text"
                        name="lastName"
                        value="<%= requestedData.lastName %>"
                        id="lastName"
                        class="form-control bg-dark text-light border-secondary"
                      />
                    </div>
                  </div>

                  <div class="form-group row">
                    <label for="email" class="col-md-3 col-form-label"
                      >Email</label
                    >
                    <div class="col-md-9">
                      <input
                        type="text"
                        name="email"
                        value="<%= requestedData.email %>"
                        id="email"
                        class="form-control bg-dark text-light border-secondary"
                      />
                    </div>
                  </div>

                  <div class="form-group row">
                    <label for="phone" class="col-md-3 col-form-label"
                      >Phone</label
                    >
                    <div class="col-md-9">
                      <input
                        type="text"
                        name="phone"
                        value="<%= requestedData.phone %>"
                        id="phone"
                        class="form-control bg-dark text-light border-secondary"
                      />
                    </div>
                  </div>

                  <div class="form-group row">
                    <label for="address" class="col-md-3 col-form-label"
                      >Address</label
                    >
                    <div class="col-md-9">
                      <textarea
                        name="address"
                        id="address"
                        rows="3"
                        class="form-control bg-dark text-light border-secondary"
                      >
<%= requestedData.address.trim() %></textarea
                      >
                    </div>
                  </div>

                  <hr style="border-color: #444" />

                  <div class="form-group row mb-0">
                    <div class="col-md-9 offset-md-3">
                      <button type="submit" class="btn btn-primary">
                        Save
                      </button>
                      <a href="/" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
<%- include('partials/footer.ejs') %>
