<%- include('partials/header.ejs') %>

<!-- content -->
<main class="py-5" style="background-color: #121212; color: #e0e0e0">
  <div class="container">
    <div class="row">
      <div class="col-md-12">
        <div class="card bg-dark text-light">
          <div class="card-header card-title bg-secondary text-light">
            <div class="d-flex align-items-center">
              <h2 class="mb-0">All Contacts</h2>
              <div class="ml-auto">
                <a href="/add-data" class="btn btn-success">
                  <i class="fa fa-plus-circle"></i> Add New
                </a>
              </div>
            </div>
          </div>
          <div class="card-body">
            <table
              class="table table-striped table-hover table-dark text-light"
            >
              <thead>
                <tr>
                  <th scope="col">#</th>
                  <th scope="col">First Name</th>
                  <th scope="col">Last Name</th>
                  <th scope="col">Email</th>
                  <th scope="col">Phone</th>
                  <th scope="col">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% let index = counter %>
                <% dataList.forEach((data) => { %>
                <tr>
                  <td><%= index++ %></td>
                  <td><%= data.firstName %></td>
                  <td><%= data.lastName %></td>
                  <td><%= data.email %></td>
                  <td><%= data.phone %></td>
                  <td width="150">
                    <a
                      href="/show-data/<%=data._id%>"
                      class="btn btn-sm btn-circle btn-outline-info"
                    >
                      <i class="fa fa-eye"></i>
                    </a>
                    <a
                      href="/update-data/<%=data._id%>"
                      class="btn btn-sm btn-circle btn-outline-secondary"
                    >
                      <i class="fa fa-edit"></i>
                    </a>
                    <a
                      href="/delete-data/<%=data._id%>"
                      class="btn btn-sm btn-circle btn-outline-danger"
                      onclick="confirm('Are you sure?')"
                    >
                      <i class="fa fa-times"></i>
                    </a>
                  </td>
                </tr>
                <%}) %>
              </tbody>
            </table>
          </div>
          <nav class="bg-dark py-3">
            <ul class="pagination justify-content-center mb-0">
              <li class="page-item <%= hasPrevPage ? "" : "disabled" %>">
                <a class="page-link <%= hasPrevPage ? "text-light bg-dark" : "text-secondary bg-dark" %> border-secondary"
                  href="/?page=<%= prevPage %>">
                  Previous
                </a>
              </li>
                  <% for (let i = 1; i <= totalPages; i++) { 
                      let activeClass = (page === i) 
                      ? "bg-secondary text-light border-secondary" 
                      : "bg-dark text-light border-secondary"; 
                  %>
              <li class="page-item">
                <a class="page-link <%= activeClass %>" href="/?page=<%= i %>">
                  <%= i %>
                </a>
              </li>
                <% } %>

              <li class="page-item <%= hasNextPage ? "" : "disabled" %>">
                <a class="page-link <%= hasNextPage ? "text-light bg-dark" : "text-secondary bg-dark" %> border-secondary"
                  href="/?page=<%= nextPage %>">
                  Next
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer.ejs') %>
